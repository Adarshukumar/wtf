# ─── Telegram Bridge configuration ─────────────────────────────
# Copy this file to `.env` and fill in the values:
#     cp .env.example .env

# Your bot token from @BotFather (REQUIRED for the bot to talk to you).
BOT_TOKEN=

# Comma-separated chat ids allowed to run admin commands (/say, /owners).
# Leave empty to treat anyone who sends /start as an admin.
ADMIN_IDS=

# Optional: a fixed owner chat id. Get yours by sending /start to the bot,
# then paste it here. The server will reach you even before the first /start.
OWNER_CHAT_ID=

# ─── Relay (local HTTP API your server pushes into) ─────────────
RELAY_HOST=0.0.0.0
RELAY_PORT=8080

# Secret key required to POST /push. Leave empty to auto-generate one
# (saved to data/api_key). Set it explicitly if you push from other machines.
API_KEY=

# ─── Reliability tuning (safe defaults — usually leave as-is) ──
SEND_RETRIES=5
BACKOFF_BASE=2.0
MAX_BACKOFF=120.0
QUEUE_WORKER_INTERVAL=1.0

# Heartbeat interval in seconds (0 = disabled). Enable per-owner with /hb on.
HEARTBEAT_INTERVAL=0

# ─── push.py client ─────────────────────────────────────────────
# If set, push.py posts to this relay first and falls back to direct send.
# Default is http://127.0.0.1:8080
RELAY_URL=

# Where the SQLite state lives.
DB_PATH=data/state.db
