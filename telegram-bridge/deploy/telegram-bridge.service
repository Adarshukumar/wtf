[Unit]
Description=Telegram server bridge (bot + relay + queue)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/telegram-bridge
ExecStart=/opt/telegram-bridge/.venv/bin/python /opt/telegram-bridge/main.py
Restart=always
RestartSec=5
# Run as your own user; adjust User= if needed.
# User=youruser
# Load secrets from the .env file next to main.py.
EnvironmentFile=/opt/telegram-bridge/.env

[Install]
WantedBy=multi-user.target
